PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/nuzio

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Comma-separated list of allowed frontend origins (no trailing slash).
# Include both your local dev URL and your deployed Vercel URL.
CLIENT_URL=http://localhost:3000,https://your-app.vercel.app
